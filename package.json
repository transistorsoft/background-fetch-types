{
  "name": "@transistorsoft/background-fetch-types",
  "version": "1.0.0",
  "description": "TypeScript type definitions for the Transistor Software Background Fetch SDK",
  "main": "./index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "dist/",
    "index.js"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json -w",
    "test": "node scripts/check-entry.js",
    "prepublishOnly": "npm run build && npm test",
    "preflight": "scripts/preflight.sh",
    "release": "scripts/release.sh"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "keywords": [
    "background-fetch",
    "react-native",
    "cordova",
    "capacitor",
    "flutter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transistorsoft/background-fetch-types.git"
  },
  "bugs": {
    "url": "https://github.com/transistorsoft/background-fetch-types/issues"
  },
  "license": "MIT",
  "author": "Transistor Software <info@transistorsoft.com>"
}
